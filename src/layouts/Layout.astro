---
import "@styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const { title = "Crypto Tracker", description = "Automatically track cryptocurrency prices" } = Astro.props as Props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<title>{title}</title>
	</head>
	<body>
    <slot />
	</body>
</html>

<style is:global>
	*, *::before, *::after {
		box-sizing: border-box;
	}
  html, body {
    margin: 0;
		padding: 0;
    background: hsl(223, 63%, 5%);
  }
</style>