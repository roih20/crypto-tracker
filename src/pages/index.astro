---
import Layout from "@layouts/Layout.astro";
import BitcoinLogo from "@assets/svg/bitcoin.svg";
import EthereumLogo from "@assets/svg/ethereum.svg";
import { getAllRows, type CryptoRow } from "../db/queries";
import type { SvgComponent } from "astro/types";

process.env.SUPABASE_URL ??= import.meta.env.SUPABASE_URL;
process.env.SUPABASE_KEY ??= import.meta.env.SUPABASE_KEY;


let coins: Record<string, { price: number, time: string }[]> = {};
let latestPrices: Record<string, string> = {};
let chartError: string | null = null;

try {
	const allRows = await getAllRows();
	const grouped = new Map<string, { price: number, trackedAt: string }[]>();
	for (const row of allRows) {
		const { price, trackedAt, crypto } = row;
		const list = grouped.get(crypto) ?? [];
		list.push({ price, trackedAt });
		grouped.set(crypto, list);
	}
	for (const [coin, data] of grouped) {
		coins[coin] = data.map(({ price, trackedAt }) => ({ price, time: trackedAt }));
		latestPrices[coin] = new Intl.NumberFormat("en-US", { style: "currency", currency: "USD" }).format(data[data.length - 1].price);
	}
} catch (error) {
	chartError = error instanceof Error ? error.message : "Connection error";
}


---

<Layout>
	<main>
		<header class="flex items-center justify-center py-4 border-b border-gray-700">
			<h1 class="text-xl font-semibold text-white">CryptoTrack</h1>
		</header>
		<section class="p-4">
			<h2 class="font-medium text-white/90 mb-2">Market Overview</h2>
			<p class="text-gray-300 leading-7 text-sm">Track the prices of Bitcoin, Ethereum, and Solana in real time.</p>
			{chartError ? (
				<div class="bg-red-500/10 text-red-400 p-4 rounded-lg mt-4">
					{chartError}
				</div>
			) : (
			 <div class="flex flex-col gap-y-4 mt-4">
			  {
					Object.entries(coins).map(([coin, data]) => (
						<div class="p-4 card rounded-lg flex flex-col gap-y-2">
							<div class="flex items-center">
								<div class="w-full">
									<h3 class="text-xl text-white font-semibold capitalize">{coin}</h3>
									<p class="text-2xl text-white mt-1">{latestPrices[coin]}</p>
								</div>
								{coin === "bitcoin" && <BitcoinLogo class="w-10 h-10" />}
							</div>
							<div id={`chart-${coin}`} class="h-32 w-full mt-1" data-chart={JSON.stringify(data)}></div>
						</div>
					))
				}
			 </div>
			)}
		</section>
	</main>
</Layout>

<style>
	.card {
		background: hsl(224, 47%, 10%);
	}
</style>

<script>

	document.addEventListener("DOMContentLoaded", async () => {
		const { createChart, AreaSeries} = await import("lightweight-charts");

		const elements = document.querySelectorAll("[data-chart]");

		const lineColorMapper: Record<string, { lineColor: string, topColor: string, bottomColor: string }> = {
			bitcoin: { lineColor: '#d49640', topColor: '#F7931A', bottomColor: 'rgba(212, 150, 64, 0.3)' },
			ethereum: { lineColor: '#3C3C3D', topColor: '#3C3C3D', bottomColor: 'rgba(60, 60, 61, 0.28)' },
			solana: { lineColor: '#00FFA3', topColor: '#00FFA3', bottomColor: 'rgba(0, 255, 163, 0.28)' }
		}

		for (const el of elements) {
			const data = JSON.parse(el.getAttribute("data-chart") || "[]");
			// Extract the coin name from the element's ID (e.g., "chart-bitcoin" -> "bitcoin")
			const coinName = el.getAttribute("id")?.substring(6).trim()!
			const parsedData = data.map(({ price, time }: { price: number, time: string }) => ({
				value: price,
				time: Math.floor(new Date(time).getTime() / 1000)
			}))
			.sort((a: { time: number }, b: { time: number }) => a.time - b.time);
			
			const chartInstance = createChart(el as HTMLElement, {
				autoSize: true,
				grid: {
					vertLines: {
						visible: false
					},
					horzLines: {
						visible: false
					}
				},
				rightPriceScale: {
					borderVisible: false,
					visible: false
				},
				timeScale: {
					borderVisible: false,
					visible: false
				},
				layout: {
					background: {
						color: 'transparent'
					}
				}
				
				
			})

			const areaSeries = chartInstance.addSeries(AreaSeries, lineColorMapper[coinName]);
			areaSeries.setData(parsedData);
			chartInstance.timeScale().fitContent();
		}
		
	})
</script>